# La configuration du bot sur sa machine : deux lignes, à copier depuis l'administration du site
# (Discord → Clé d'accès du bot). Tout le reste — la clé Discord, le serveur, les correspondances,
# l'interrupteur marche/pause — se règle dans cette administration.
#
# Copier ce fichier en `.env` (pour `npm start`), ou dans le fichier lu par le service systemd
# (EnvironmentFile, cf. neofrag-bot.service). Ne jamais le versionner : la clé y est en clair.

NF_SITE_URL=https://example.org/
NF_API_KEY=nfr_0000000000000000000000000000000000000000

# Facultatif : secondes entre deux signes de vie au site (10 à 300, 30 par défaut).
# NF_BOT_INTERVALLE=30
