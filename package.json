{
    "name": "neofrag-reborn-bot",
    "version": "0.2.2",
    "private": true,
    "description": "Le bot Discord de NeoFrag Reborn : il relie un site et son serveur Discord. Il se règle depuis l'administration du site (module « Discord ») et ne garde sur sa machine que l'adresse du site et une clé d'accès.",
    "license": "LGPL-3.0-or-later",
    "author": "NeoFrag Reborn",
    "homepage": "https://neofrag-reborn.xyz",
    "repository": {
        "type": "git",
        "url": "https://github.com/NeoFragReborn/bot-discord.git"
    },
    "bugs": {
        "url": "https://github.com/NeoFragReborn/bot-discord/issues"
    },
    "type": "module",
    "engines": {
        "node": ">=22.9"
    },
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node --env-file-if-exists=.env dist/index.js",
        "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\""
    },
    "dependencies": {
        "discord.js": "^14.27.0"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "typescript": "^7.0.2"
    }
}
